# Copy to .env (git-ignored) and fill in. Never commit real values.

# Intent Layer (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Control Layer device credentials (names referenced from kb/inventory.yaml)
IBN_USERNAME=admin
IBN_PASSWORD=
IBN_ENABLE_SECRET=

# Optional: Batfish server for the simulation stage (pip install pybatfish)
# BATFISH_HOST=localhost
